datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  passwordHash         String?
  fullName             String
  role                 String                @default("USER")
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  profiles             Profile[]
  readings             Reading[]
  auditLogs            AuditLog[]
  compatibilityReports CompatibilityReport[]

  @@index([email])
}

model Profile {
  id                 String              @id @default(uuid())
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  gender             String              @default("OTHER")
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  birthData          BirthData?
  astroCharts        AstrologyChart[]
  tuviCharts         TuViChart[]
  numerologyProfiles NumerologyProfile[]
  tarotReadings      TarotReading[]

  @@index([userId])
}

model BirthData {
  id                    String   @id @default(uuid())
  profileId             String   @unique
  profile               Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  birthDate             DateTime
  birthTime             String?
  timeAccuracy          String   @default("EXACT")
  country               String   @default("Vietnam")
  city                  String   @default("Hanoi")
  latitude              Float    @default(21.0285)
  longitude             Float    @default(105.8542)
  timezone              String   @default("Asia/Ho_Chi_Minh")
  timezoneOffsetMinutes Int      @default(420)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([profileId])
}

model AstrologyChart {
  id            String             @id @default(uuid())
  profileId     String?
  profile       Profile?           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  engineVersion String             @default("2.0.0")
  configVersion String             @default("V2_EVIDENCE")
  zodiacSystem  String             @default("TROPICAL")
  houseSystem   String             @default("PLACIDUS")
  julianDay     Float
  hasExactTime  Boolean            @default(true)
  inputHash     String
  createdAt     DateTime           @default(now())

  positions     AstrologyPosition[]
  houses        AstrologyHouse[]
  aspects       AstrologyAspect[]

  @@index([profileId])
  @@index([inputHash, engineVersion, configVersion])
}

model AstrologyPosition {
  id           String         @id @default(uuid())
  chartId      String
  chart        AstrologyChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  body         String
  longitude    Float
  latitude     Float
  distance     Float
  speed        Float
  isRetrograde Boolean        @default(false)
  sign         String
  signDegree   Float
  houseNumber  Int?
  createdAt    DateTime       @default(now())

  @@index([chartId, body])
}

model AstrologyHouse {
  id            String         @id @default(uuid())
  chartId       String
  chart         AstrologyChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  houseNumber   Int
  cuspLongitude Float
  sign          String
  signDegree    Float
  createdAt     DateTime       @default(now())

  @@unique([chartId, houseNumber])
}

model AstrologyAspect {
  id         String         @id @default(uuid())
  chartId    String
  chart      AstrologyChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  bodyA      String
  bodyB      String
  aspectType String
  angle      Float
  orb        Float
  isApplying Boolean
  createdAt  DateTime       @default(now())

  @@index([chartId])
}

model TuViChart {
  id              String         @id @default(uuid())
  profileId       String?
  profile         Profile?       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  methodVersion   String         @default("TUVI_NAM_PHAI_V1")
  solarDate       DateTime
  lunarDay        Int
  lunarMonth      Int
  lunarYear       Int
  isLeapMonth     Boolean        @default(false)
  lunarHourBranch String
  yearStem        String
  yearBranch      String
  monthStem       String
  monthBranch     String
  dayStem         String
  dayBranch       String
  hourStem        String
  hourBranch      String
  menhNguHanh     String
  menhDetail      String
  cuc             String
  cucNumber       Int
  thanBranch      String
  menhBranch      String
  amDuongNamNu    String
  inputHash       String
  createdAt       DateTime       @default(now())

  palaces         TuViPalace[]
  cycles          TuViCycle[]

  @@index([profileId])
  @@index([inputHash, methodVersion])
}

model TuViPalace {
  id             String              @id @default(uuid())
  chartId        String
  chart          TuViChart           @relation(fields: [chartId], references: [id], onDelete: Cascade)
  palaceName     String
  branch         String
  stem           String
  isThan         Boolean             @default(false)
  isTuan         Boolean             @default(false)
  isTriet        Boolean             @default(false)
  daiHanStartAge Int
  daiHanEndAge   Int
  createdAt      DateTime            @default(now())

  stars          TuViStarPlacement[]

  @@unique([chartId, palaceName])
  @@unique([chartId, branch])
}

model TuViStarPlacement {
  id         String     @id @default(uuid())
  palaceId   String
  palace     TuViPalace @relation(fields: [palaceId], references: [id], onDelete: Cascade)
  starCode   String
  starName   String
  starGroup  String
  brightness String?
  element    String
  createdAt  DateTime   @default(now())

  @@index([palaceId, starCode])
}

model TuViCycle {
  id           String    @id @default(uuid())
  chartId      String
  chart        TuViChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  cycleType    String
  yearNumber   Int
  age          Int
  palaceBranch String
  createdAt    DateTime  @default(now())

  @@index([chartId, yearNumber])
}

model NumerologyProfile {
  id             String             @id @default(uuid())
  profileId      String?
  profile        Profile?           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  engineVersion  String             @default("PYTHAGOREAN_V1")
  configVersion  String             @default("V1")
  normalizedName String
  birthDate      DateTime
  inputHash      String
  createdAt      DateTime           @default(now())

  results        NumerologyResult[]
  cycles         NumerologyCycle[]

  @@index([profileId])
  @@index([inputHash, engineVersion])
}

model NumerologyResult {
  id             String            @id @default(uuid())
  numerologyId   String
  numerology     NumerologyProfile @relation(fields: [numerologyId], references: [id], onDelete: Cascade)
  numberType     String
  rawCalculation String
  finalValue     Int
  isMasterNumber Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@unique([numerologyId, numberType])
}

model NumerologyCycle {
  id           String            @id @default(uuid())
  numerologyId String
  numerology   NumerologyProfile @relation(fields: [numerologyId], references: [id], onDelete: Cascade)
  cycleType    String
  cycleNumber  Int
  startAge     Int?
  endAge       Int?
  yearNumber   Int?
  value        Int
  createdAt    DateTime          @default(now())

  @@index([numerologyId, yearNumber])
}

model TarotDeck {
  id         String         @id @default(uuid())
  code       String         @unique
  name       String
  version    String         @default("1.0.0")
  totalCards Int            @default(78)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  cards      TarotCard[]
  readings   TarotReading[]
}

model TarotCard {
  id        String      @id @default(uuid())
  deckId    String
  deck      TarotDeck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardCode  String
  name      String
  arcana    String
  suit      String?
  number    Int
  keywords  String      @default("[]")
  imagePath String
  createdAt DateTime    @default(now())

  draws     TarotDraw[]

  @@unique([deckId, cardCode])
}

model TarotSpread {
  id          String                @id @default(uuid())
  code        String                @unique
  name        String
  cardCount   Int
  description String
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())

  positions   TarotSpreadPosition[]
  readings    TarotReading[]
}

model TarotSpreadPosition {
  id            String      @id @default(uuid())
  spreadId      String
  spread        TarotSpread @relation(fields: [spreadId], references: [id], onDelete: Cascade)
  positionIndex Int
  name          String
  description   String
  createdAt     DateTime    @default(now())

  draws         TarotDraw[]

  @@unique([spreadId, positionIndex])
}

model TarotReading {
  id               String      @id @default(uuid())
  profileId        String?
  profile          Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  deckId           String
  deck             TarotDeck   @relation(fields: [deckId], references: [id])
  spreadId         String
  spread           TarotSpread @relation(fields: [spreadId], references: [id])
  seed             String
  shuffleAlgorithm String      @default("FISHER_YATES_CSPRNG")
  engineVersion    String      @default("RIDER_WAITE_V1")
  rulesetVersion   String      @default("V1")
  createdAt        DateTime    @default(now())

  draws            TarotDraw[]

  @@index([profileId])
  @@index([seed])
}

model TarotDraw {
  id         String              @id @default(uuid())
  readingId  String
  reading    TarotReading        @relation(fields: [readingId], references: [id], onDelete: Cascade)
  positionId String
  position   TarotSpreadPosition @relation(fields: [positionId], references: [id])
  cardId     String
  card       TarotCard           @relation(fields: [cardId], references: [id])
  isReversed Boolean             @default(false)
  drawOrder  Int
  createdAt  DateTime            @default(now())

  @@unique([readingId, positionId])
}

model RuleSet {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  scope     String
  version   String        @default("1.0.0")
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  rules     Rule[]
  versions  RuleVersion[]
}

model Rule {
  id               String          @id @default(uuid())
  ruleCode         String          @unique
  ruleSetId        String
  ruleSet          RuleSet         @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  scope            String
  priority         Int
  specificityScore Int             @default(10)
  status           String          @default("PUBLISHED")
  version          String          @default("1.0.0")
  description      String
  conditionAst     String          @default("{}")
  actionPayload    String          @default("{}")
  interpretationId String?
  interpretation   Interpretation? @relation(fields: [interpretationId], references: [id], onDelete: SetNull)
  tags             String          @default("[]")
  createdBy        String          @default("SYSTEM")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  versions         RuleVersion[]

  @@index([scope, status])
  @@index([priority])
}

model RuleVersion {
  id             String   @id @default(uuid())
  ruleId         String
  rule           Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleSetId      String
  ruleSet        RuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  versionNumber  String
  snapshotAst    String   @default("{}")
  snapshotAction String   @default("{}")
  changeNote     String
  createdBy      String
  createdAt      DateTime @default(now())

  @@unique([ruleId, versionNumber])
}

model Interpretation {
  id        String                @id @default(uuid())
  code      String                @unique
  scope     String
  category  String
  themes    String                @default("[]")
  version   String                @default("1.0.0")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  rules     Rule[]
  blocks    InterpretationBlock[]

  @@index([scope, category])
}

model InterpretationBlock {
  id               String         @id @default(uuid())
  interpretationId String
  interpretation   Interpretation @relation(fields: [interpretationId], references: [id], onDelete: Cascade)
  domain           String
  languageCode     String         @default("vi")
  templateText     String
  variableSchema   String         @default("{}")
  version          String         @default("1.0.0")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([interpretationId, domain, languageCode])
}

model Reading {
  id               String             @id @default(uuid())
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  readingType      String
  engineVersion    String             @default("2.0.0")
  configVersion    String             @default("V2_EVIDENCE")
  rulesetVersion   String             @default("RULESET_V2")
  knowledgeVersion String             @default("2.0.0")
  inputHash        String
  inputSnapshot    String             @default("{}")
  factsSnapshot    String             @default("{}")
  matchedRuleCodes String             @default("[]")
  qualityScore     Int?               @default(100)
  isDegraded       Boolean            @default(false)
  warnings         String?            @default("[]")
  createdDate      DateTime           @default(now())

  sections         ReadingSection[]
  ruleTraces       ReadingRuleTrace[]

  @@index([userId])
  @@index([inputHash, rulesetVersion])
}

model ReadingSection {
  id               String   @id @default(uuid())
  readingId        String
  reading          Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  sectionOrder     Int
  domain           String
  title            String
  renderedText     String
  sourceRuleCode   String
  interpretationId String
  themes           String?  @default("[]")
  actionableAdvice String?
  explanation      String?
  sourceReference  String?
  laymanSummary    String?
  provenanceTraces String?  @default("[]")
  createdAt        DateTime @default(now())

  @@index([readingId, sectionOrder])
}

model ReadingRuleTrace {
  id                  String   @id @default(uuid())
  readingId           String
  reading             Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  ruleCode            String
  status              String
  specificity         Int
  priority            Int
  evaluatedConditions String   @default("[]")
  skipReason          String?
  createdAt           DateTime @default(now())

  @@index([readingId, ruleCode])
}

model CompatibilityReport {
  id               String   @id @default(uuid())
  creatorUserId    String?
  creatorUser      User?    @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  personAProfileId String?
  personBProfileId String?
  personAName      String
  personBName      String
  precisionLevel   String   @default("BASIC")
  relationshipType String   @default("LOVE")
  methodVersion    String   @default("COMPATIBILITY_V1")
  rulesetVersion   String   @default("COMPATIBILITY_V1")
  factsSnapshot    String   @default("{}")
  reportSections   String   @default("[]")
  dimensions       String   @default("[]")
  synthesis        String   @default("{}")
  guidance         String   @default("[]")
  createdAt        DateTime @default(now())

  @@index([creatorUserId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeState String?
  afterState  String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
